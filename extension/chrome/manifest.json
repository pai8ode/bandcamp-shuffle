{
  "manifest_version": 3,
  "name": "Bandcamp Shuffle",
  "version": "1.1.0",
  "description": "Shuffle-play the fedexlatte Bandcamp collection, one random track after another.",
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://bandcamp.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Bandcamp Shuffle",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
